<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="VR.QrCodeGenerator.MAUI.Views.PicturePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VR.QrCodeGenerator.MAUI.Controls"
             xmlns:vm="clr-namespace:VR.QrCodeGenerator.ViewModel.ViewModels;assembly=VR.QrCodeGenerator.ViewModel"
             Title="{Binding PageTitle}"
             x:DataType="vm:PictureCodesViewModel">
    <controls:QrGeneratorView>
        <controls:QrGeneratorView.TopContent>
            <VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Style="{StaticResource SectionHeaderLabelStyle}" Text="Picture" />
                    <Label Grid.Column="1"
                           Margin="0,20,0,8"
                           Padding="8,0,4,0"
                           FontSize="18"
                           SemanticProperties.Description="Help"
                           Text="ⓘ"
                           TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                           VerticalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="PictureHelp_OnTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="8">
                        <!--
                            The template: the picture as it will be drawn, the blue square is the code. Drag, resize by
                            its corner, pinch, or touch to put it there. White in both themes, like the drawing sheet.
                        -->
                        <Border Padding="4"
                                HeightRequest="300"
                                Style="{StaticResource PaperBorderStyle}">
                            <Grid>
                                <controls:PicturePlacementView CodeCenter="{Binding CodeCenter}"
                                                               CodeSize="{Binding CodeSize}"
                                                               Image="{Binding TemplatePreview}"
                                                               MaxCodeSize="{x:Static vm:PictureCodesViewModel.MaxCodeSize}"
                                                               MinCodeSize="{x:Static vm:PictureCodesViewModel.MinCodeSize}"
                                                               TemplateHeight="{Binding TemplateHeight}"
                                                               TemplateWidth="{Binding TemplateWidth}" />

                                <!--  Empty state until a picture is chosen.  -->
                                <VerticalStackLayout HorizontalOptions="Center"
                                                     IsVisible="{Binding HasPicture, Converter={StaticResource InvertedBoolConverter}}"
                                                     Spacing="4"
                                                     VerticalOptions="Center">
                                    <Label HorizontalTextAlignment="Center"
                                           Text="Choose a picture, or share one with this app"
                                           TextColor="#99000000" />
                                    <Label FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           Text="Photos, silhouettes and line art all work"
                                           TextColor="#99000000" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Label x:Name="PictureCaption"
                               LineBreakMode="TailTruncation"
                               Style="{StaticResource CaptionLabelStyle}"
                               Text="The picture is drawn around the code. The blue square is the code." />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button Command="{Binding CenterCodeCommand}"
                                    IsEnabled="{Binding HasPicture}"
                                    Text="Center" />
                            <Button Grid.Column="1"
                                    Command="{Binding RemovePictureCommand}"
                                    Text="Remove" />
                        </Grid>
                        <Button Command="{Binding ChoosePictureCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="Choose picture" />
                    </VerticalStackLayout>
                </Border>

                <controls:SettingsCard Description="{Binding SelectedSource.Description}"
                                       Header="Shape from"
                                       HelpText="Which part of your picture appears around the QR code.&#x0a;&#x0a;• Whole picture: everything in the picture, turned into tiny black and white dots, like a photo printed in a newspaper. Best for photos.&#x0a;&#x0a;• Subject: only the main thing in the picture, such as a person or an animal on a plain background. The background stays white and the subject gets an outline.&#x0a;&#x0a;• QR code color: only the parts that have the same color as your QR code (black by default), for example the lines of a drawing. They are filled with a QR-style pattern, like the chicken on the Custom tab.">
                    <Picker ItemsSource="{x:Static vm:PictureCodesViewModel.Sources}" SelectedItem="{Binding SelectedSource}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="Lighter or darker before the picture is turned into dots. Raise it for dark photos."
                                       Header="Brightness"
                                       HelpText="Makes the picture lighter or darker before it is turned into dots.&#x0a;&#x0a;If the result looks too black, move the slider to the right. If it looks faded, move it to the left.&#x0a;&#x0a;This only changes the picture, never the QR code itself."
                                       IsActive="{Binding UsesTones}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Slider Maximum="0.5"
                                Minimum="-0.5"
                                Value="{Binding Brightness, Converter={StaticResource SnapConverter}, ConverterParameter=0.05}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource ValueLabelStyle}"
                               Text="{Binding Brightness, StringFormat='{0:+0%;-0%;0%}'}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Description="More contrast makes shapes stand out; less keeps soft shading."
                                       Header="Contrast"
                                       HelpText="How strongly the light and dark parts of the picture are separated.&#x0a;&#x0a;More contrast gives bold, clear shapes. Less keeps soft shading. If the picture looks gray and muddy, try more contrast."
                                       IsActive="{Binding UsesTones}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Slider Maximum="2"
                                Minimum="0.5"
                                Value="{Binding Contrast, Converter={StaticResource SnapConverter}, ConverterParameter=0.1}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource ValueLabelStyle}"
                               Text="{Binding Contrast, StringFormat='{0:P0}'}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Description="How much of the picture counts as the shape. Raise it if parts are missing, lower it if the background creeps in."
                                       Header="Sensitivity"
                                       HelpText="Decides how much of the picture counts as your subject or drawing.&#x0a;&#x0a;Raise it if parts of it are missing. Lower it if bits of the background show up.&#x0a;&#x0a;Only for the Subject and QR code color shapes: with Whole picture, all of the picture is used anyway."
                                       IsActive="{Binding UsesSensitivity}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Slider Maximum="0.8"
                                Minimum="0.2"
                                Value="{Binding Sensitivity, Converter={StaticResource SnapConverter}, ConverterParameter=0.05}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource ValueLabelStyle}"
                               Text="{Binding Sensitivity, StringFormat='{0:P0}'}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Description="The code's share of the picture. Smaller leaves more of the picture around it, with more detail."
                                       Header="Code size"
                                       HelpText="How big the QR code is compared to the picture.&#x0a;&#x0a;A smaller code leaves more room for the picture. But if you print the image small, a tiny code becomes hard for a phone to read, so keep it big enough to see its little squares clearly.&#x0a;&#x0a;You can also resize the blue square on the picture: pinch it with two fingers, or drag its white corner.">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Slider Maximum="{x:Static vm:PictureCodesViewModel.MaxCodeSize}"
                                Minimum="{x:Static vm:PictureCodesViewModel.MinCodeSize}"
                                Value="{Binding CodeSize, Converter={StaticResource SnapConverter}, ConverterParameter=0.01}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource ValueLabelStyle}"
                               Text="{Binding CodeSize, StringFormat='{0:P0}'}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Description="{Binding SelectedDetail.Description}"
                                       Header="Detail"
                                       HelpText="How small the dots that make up the picture are.&#x0a;&#x0a;Smaller dots show more detail: Ultra looks most like the original picture. Normal gives a chunky, pixel-art look.&#x0a;&#x0a;The QR code itself works the same at every setting.">
                    <Picker ItemsSource="{x:Static vm:PictureCodesViewModel.Details}" SelectedItem="{Binding SelectedDetail}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="{Binding SelectedCodeBlend.Description}"
                                       Header="Code blending"
                                       HelpText="Lets the picture show through the QR code, so it does not look like a sticker on top.&#x0a;&#x0a;A phone only reads the middle of each little square of a QR code, so the edges of each square can follow the picture.&#x0a;&#x0a;• Off: a plain black and white code.&#x0a;• Subtle: a little of the picture. The easiest to scan.&#x0a;• Balanced: a good mix.&#x0a;• Strong: the code almost disappears. Check that your phone can still scan it.&#x0a;&#x0a;The three big squares in the corners always stay solid: phones use them to find the code.&#x0a;&#x0a;Needs Extra fine or Ultra detail, and the Whole picture or Subject shape."
                                       IsActive="{Binding CanBlendCode}">
                    <VerticalStackLayout Spacing="6">
                        <Picker ItemsSource="{x:Static vm:PictureCodesViewModel.CodeBlends}" SelectedItem="{Binding SelectedCodeBlend}" />
                        <Label Style="{StaticResource CaptionLabelStyle}" Text="Needs Extra fine or Ultra detail and the Whole picture or Subject shape. Every code is still checked to scan; if needed, the code is drawn more solid." />
                    </VerticalStackLayout>
                </controls:SettingsCard>
            </VerticalStackLayout>
        </controls:QrGeneratorView.TopContent>
    </controls:QrGeneratorView>
</ContentPage>
