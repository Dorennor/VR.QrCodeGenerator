<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android only. MAUI 11 (the installed workload) builds net11.0 apps; the shared projects stay net10.0. -->
    <TargetFramework>net11.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>VR.QrCodeGenerator.MAUI</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Compiled bindings: every binding is checked against the page's x:DataType at build time. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationTitle>QR Code Generator</ApplicationTitle>
    <ApplicationId>com.vr.qrcodegenerator</ApplicationId>
    <ApplicationDisplayVersion>1.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>

    <!-- Android 10: saving to Pictures through MediaStore needs no storage permission from there on. -->
    <SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>

    <Product>QR Code Generator</Product>
    <Description>QR codes, custom styles (Kurkod, cat, dog), drawings and pictures</Description>
    <Authors>Volodymyr Rud</Authors>
    <Copyright>Copyright © 2026 Volodymyr Rud</Copyright>

    <!-- An .apk that can be sent and installed directly (Release would otherwise make an .aab for Google Play). -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- settings.json is read and written by reflection (System.Text.Json), as on Windows. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0078D4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0078D4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- Same SkiaSharp as the Service project, which draws and reads the images. -->
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VR.QrCodeGenerator.ViewModel\VR.QrCodeGenerator.ViewModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Settings classes are serialized by reflection, so keep them whole when the release build is trimmed. -->
    <TrimmerRootAssembly Include="VR.QrCodeGenerator.Model" />
  </ItemGroup>

</Project>
