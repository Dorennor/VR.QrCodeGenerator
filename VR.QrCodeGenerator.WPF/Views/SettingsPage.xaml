<Page x:Class="VR.QrCodeGenerator.WPF.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:VR.QrCodeGenerator.WPF.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings"
      d:DesignHeight="800"
      d:DesignWidth="900"
      Style="{StaticResource AppPageStyle}"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContentPanelStyle}">
            <Grid Style="{StaticResource PageHeaderGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Settings" />
                    <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Output folder and logging. Saved to your user profile (%LOCALAPPDATA%\VR.QrCodeGenerator) and applied right away." />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource PageHeaderCommandsStyle}">
                    <ui:Button Command="{Binding LoadCommand}"
                               Content="Discard changes"
                               Icon="{ui:SymbolIcon ArrowUndo24}"
                               ToolTip="Show the saved settings again" />
                    <ui:Button Margin="8,0,0,0"
                               Appearance="Primary"
                               Command="{Binding SaveCommand}"
                               Content="Save settings"
                               Icon="{ui:SymbolIcon Save24}" />
                </StackPanel>
            </Grid>

            <TextBlock Margin="1,4,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding StatusMessage}" />

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Output" />

            <controls:SettingsCard Description="Off: QR codes are saved to the Output folder beside the app."
                                   Header="Use a custom output folder"
                                   Icon="{ui:SymbolIcon FolderArrowRight24}">
                <ui:ToggleSwitch IsChecked="{Binding UseCustomPath}" />
            </controls:SettingsCard>

            <controls:SettingsCard Description="Folder that generated QR codes are saved to."
                                   Header="Output folder"
                                   Icon="{ui:SymbolIcon Folder24}"
                                   IsEnabled="{Binding UseCustomPath}"
                                   IsStacked="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="For example D:\QR codes" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Stretch"
                               Command="{Binding BrowseOutputPathCommand}"
                               Content="Browse"
                               Icon="{ui:SymbolIcon FolderOpen24}" />
                </Grid>
            </controls:SettingsCard>

            <controls:SettingsCard Description="{Binding EffectiveOutputFolder}"
                                   Header="QR codes will be saved to"
                                   Icon="{ui:SymbolIcon Info24}" />

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Logging" />

            <controls:SettingsCard Description="Writes a daily log file to %LOCALAPPDATA%\VR.QrCodeGenerator\Logs."
                                   Header="Log to file"
                                   Icon="{ui:SymbolIcon DocumentText24}">
                <ui:ToggleSwitch IsChecked="{Binding LogToFile}" />
            </controls:SettingsCard>

            <controls:SettingsCard Description="Also logs debug details. Useful when reporting a problem."
                                   Header="Detailed logging"
                                   Icon="{ui:SymbolIcon Bug24}">
                <ui:ToggleSwitch IsChecked="{Binding DebugLogging}" />
            </controls:SettingsCard>

            <controls:SettingsCard Description="Writes log messages to a console, when the app is started from one."
                                   Header="Log to console"
                                   Icon="{ui:SymbolIcon WindowConsole20}">
                <ui:ToggleSwitch IsChecked="{Binding LogToConsole}" />
            </controls:SettingsCard>

            <StackPanel Style="{StaticResource ActionBarPanelStyle}">
                <ui:Button Command="{Binding OpenLogsFolderCommand}"
                           Content="Open logs folder"
                           Icon="{ui:SymbolIcon FolderOpen24}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
