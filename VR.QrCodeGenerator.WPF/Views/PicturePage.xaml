<Page x:Class="VR.QrCodeGenerator.WPF.Views.PicturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:VR.QrCodeGenerator.WPF.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Picture"
      d:DesignHeight="800"
      d:DesignWidth="1000"
      Style="{StaticResource AppPageStyle}"
      mc:Ignorable="d">
    <controls:QrGeneratorView>
        <controls:QrGeneratorView.TopContent>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Picture" />

                <!--  Drop a file here, or use Choose picture.  -->
                <Border AllowDrop="True"
                        DragOver="Picture_OnDragOver"
                        Drop="Picture_OnDrop"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <!--
                            The template: black becomes the shape, the blue square is the code. Drag the square to move
                            the code, or click anywhere to put it there. Template and square share one Viewbox, so mouse
                            positions on the canvas are template pixels. White in both themes, like the drawing canvas.
                        -->
                        <Border Height="260"
                                Background="White"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Viewbox Margin="4" Stretch="Uniform">
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPicture}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <Grid Width="{Binding TemplateWidth}" Height="{Binding TemplateHeight}">
                                        <Image RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Source="{Binding TemplatePreview}"
                                               Stretch="Fill" />
                                        <Canvas Background="Transparent"
                                                Cursor="SizeAll"
                                                MouseLeftButtonDown="CodeArea_OnMouseLeftButtonDown"
                                                MouseLeftButtonUp="CodeArea_OnMouseLeftButtonUp"
                                                MouseMove="CodeArea_OnMouseMove"
                                                MouseWheel="CodeArea_OnMouseWheel"
                                                ToolTip="Drag the blue square to move the code, drag its corner (or use the mouse wheel) to resize it, or click where it should go">
                                            <Border Canvas.Left="{Binding CodeLeft}"
                                                    Canvas.Top="{Binding CodeTop}"
                                                    Width="{Binding CodeSide}"
                                                    Height="{Binding CodeSide}"
                                                    Background="#590078D4"
                                                    BorderBrush="#FF0078D4"
                                                    BorderThickness="2"
                                                    IsHitTestVisible="False">
                                                <Viewbox Margin="8">
                                                    <ui:SymbolIcon Foreground="#FF0078D4" Symbol="QrCode24" />
                                                </Viewbox>
                                            </Border>

                                            <!--  Resize handle: drag to make the code bigger or smaller around its centre.  -->
                                            <Border Canvas.Left="{Binding CodeHandleLeft}"
                                                    Canvas.Top="{Binding CodeHandleTop}"
                                                    Width="{Binding CodeHandleSize}"
                                                    Height="{Binding CodeHandleSize}"
                                                    Background="White"
                                                    BorderBrush="#FF0078D4"
                                                    BorderThickness="3"
                                                    CornerRadius="3"
                                                    IsHitTestVisible="False" />
                                        </Canvas>
                                    </Grid>
                                </Viewbox>

                                <!--  Empty state until a picture is chosen.  -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPicture}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ui:SymbolIcon HorizontalAlignment="Center"
                                                   FontSize="48"
                                                   Foreground="#80000000"
                                                   Symbol="ImageAdd24" />
                                    <TextBlock Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#99000000"
                                               Text="Choose a picture or drop one here" />
                                    <TextBlock Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#99000000"
                                               Text="Silhouettes and line art work best" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding PictureName, StringFormat={}{0}: drag the blue square to move the code, TargetNullValue='The picture is drawn around the code. The blue square is the code.'}"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Style="{StaticResource ActionBarPanelStyle}">
                            <ui:Button Command="{Binding CenterCodeCommand}"
                                       Content="Center"
                                       Icon="{ui:SymbolIcon AlignCenterHorizontal24}"
                                       IsEnabled="{Binding HasPicture}"
                                       ToolTip="Put the code back in the middle of the picture" />
                            <ui:Button Margin="8,0,0,0"
                                       Command="{Binding RemovePictureCommand}"
                                       Content="Remove"
                                       Icon="{ui:SymbolIcon Dismiss24}" />
                            <ui:Button Margin="8,0,0,0"
                                       Appearance="Primary"
                                       Command="{Binding ChoosePictureCommand}"
                                       Content="Choose picture"
                                       Icon="{ui:SymbolIcon ImageAdd24}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <controls:SettingsCard Margin="0,4,0,4"
                                       Description="{Binding SelectedSource.Description}"
                                       Header="Shape from"
                                       Icon="{ui:SymbolIcon ImageEdit24}"
                                       IsStacked="True">
                    <ComboBox DisplayMemberPath="Name"
                              ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="Lighter or darker before the picture is turned into dots. Raise it for dark photos."
                                       Header="Brightness"
                                       Icon="{ui:SymbolIcon BrightnessHigh24}"
                                       IsEnabled="{Binding UsesTones}"
                                       IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="0.5"
                                Minimum="-0.5"
                                TickFrequency="0.05"
                                Value="{Binding Brightness}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{Binding Brightness, StringFormat={}{0:+0%;-0%;0%}}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Description="More contrast makes shapes stand out; less keeps soft shading."
                                       Header="Contrast"
                                       Icon="{ui:SymbolIcon DarkTheme24}"
                                       IsEnabled="{Binding UsesTones}"
                                       IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="2"
                                Minimum="0.5"
                                TickFrequency="0.1"
                                Value="{Binding Contrast}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{Binding Contrast, StringFormat={}{0:P0}}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Description="How much of the picture counts as the shape. Raise it if parts are missing, lower it if the background creeps in."
                                       Header="Sensitivity"
                                       Icon="{ui:SymbolIcon Options24}"
                                       IsEnabled="{Binding UsesSensitivity}"
                                       IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="0.8"
                                Minimum="0.2"
                                TickFrequency="0.05"
                                Value="{Binding Sensitivity}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{Binding Sensitivity, StringFormat={}{0:P0}}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Description="The code's share of the picture. Smaller leaves more of the picture around it, with more detail."
                                       Header="Code size"
                                       Icon="{ui:SymbolIcon QrCode24}"
                                       IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <!--  Fine steps: resizing on the template sets any size, and snapping would move it.  -->
                        <Slider VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="0.7"
                                Minimum="0.15"
                                TickFrequency="0.01"
                                Value="{Binding CodeSize}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{Binding CodeSize, StringFormat={}{0:P0}}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Margin="0,0,0,4"
                                       Description="{Binding SelectedDetail.Description}"
                                       Header="Detail"
                                       Icon="{ui:SymbolIcon ZoomIn24}"
                                       IsStacked="True">
                    <ComboBox DisplayMemberPath="Name"
                              ItemsSource="{Binding Details}"
                              SelectedItem="{Binding SelectedDetail}" />
                </controls:SettingsCard>

                <controls:SettingsCard Margin="0,0,0,4"
                                       Description="{Binding SelectedCodeBlend.Description}"
                                       Header="Code blending"
                                       Icon="{ui:SymbolIcon Blur24}"
                                       IsEnabled="{Binding CanBlendCode}"
                                       IsStacked="True">
                    <StackPanel>
                        <ComboBox DisplayMemberPath="Name"
                                  ItemsSource="{Binding CodeBlends}"
                                  SelectedItem="{Binding SelectedCodeBlend}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="Needs Extra fine or Ultra detail and the Whole picture or Subject shape. Every code is still checked to scan; if needed, the code is drawn more solid." />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>
        </controls:QrGeneratorView.TopContent>
    </controls:QrGeneratorView>
</Page>
