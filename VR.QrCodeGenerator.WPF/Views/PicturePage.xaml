<Page x:Class="VR.QrCodeGenerator.WPF.Views.PicturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:VR.QrCodeGenerator.WPF.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:VR.QrCodeGenerator.ViewModel.ViewModels;assembly=VR.QrCodeGenerator.ViewModel"
      Title="Picture"
      d:DesignHeight="800"
      d:DesignWidth="1000"
      Style="{StaticResource AppPageStyle}"
      mc:Ignorable="d">
    <controls:QrGeneratorView>
        <controls:QrGeneratorView.TopContent>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Picture" />

                <!--  Drop a file here, or use Choose picture.  -->
                <Border AllowDrop="True"
                        DragOver="Picture_OnDragOver"
                        Drop="Picture_OnDrop"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <!--
                            The template: the picture as it will be drawn, the blue square is the code. The square can be
                            dragged, resized and clicked into place (CodePlacementOverlay). Template and square share one
                            Viewbox, so mouse positions are template pixels. White in both themes, like the drawing canvas.
                        -->
                        <Border Height="260"
                                Background="White"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Border.ToolTip>
                                <ToolTip Style="{StaticResource HelpToolTipStyle}" Content="This is your picture as it will appear around the QR code. The blue square is where the QR code goes.&#x0a;&#x0a;• Drag the blue square to move the code.&#x0a;• Drag its white corner, or turn the mouse wheel, to make it bigger or smaller.&#x0a;• Click anywhere on the picture to put the code there." />
                            </Border.ToolTip>
                            <Grid>
                                <Viewbox Margin="4" Stretch="Uniform">
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPicture}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <Grid Width="{Binding TemplateWidth}" Height="{Binding TemplateHeight}">
                                        <Image RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Source="{Binding TemplatePreview}"
                                               Stretch="Fill" />
                                        <controls:CodePlacementOverlay AreaHeight="{Binding TemplateHeight}"
                                                                       AreaWidth="{Binding TemplateWidth}"
                                                                       CodeCenter="{Binding CodeCenter}"
                                                                       CodeSize="{Binding CodeSize}"
                                                                       MaxCodeSize="{x:Static vm:PictureCodesViewModel.MaxCodeSize}"
                                                                       MinCodeSize="{x:Static vm:PictureCodesViewModel.MinCodeSize}" />
                                    </Grid>
                                </Viewbox>

                                <!--  Empty state until a picture is chosen.  -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPicture}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ui:SymbolIcon HorizontalAlignment="Center"
                                                   FontSize="48"
                                                   Foreground="#80000000"
                                                   Symbol="ImageAdd24" />
                                    <TextBlock Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#99000000"
                                               Text="Choose a picture or drop one here" />
                                    <TextBlock Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#99000000"
                                               Text="Silhouettes and line art work best" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding PictureName, StringFormat={}{0}: drag the blue square to move the code, TargetNullValue='The picture is drawn around the code. The blue square is the code.'}"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Style="{StaticResource ActionBarPanelStyle}">
                            <ui:Button Command="{Binding CenterCodeCommand}"
                                       Content="Center"
                                       Icon="{ui:SymbolIcon AlignCenterHorizontal24}"
                                       IsEnabled="{Binding HasPicture}"
                                       ToolTip="Put the QR code back in the middle of the picture." />
                            <ui:Button Margin="8,0,0,0"
                                       Command="{Binding RemovePictureCommand}"
                                       Content="Remove"
                                       Icon="{ui:SymbolIcon Dismiss24}" />
                            <ui:Button Margin="8,0,0,0"
                                       Appearance="Primary"
                                       Command="{Binding ChoosePictureCommand}"
                                       Content="Choose picture"
                                       Icon="{ui:SymbolIcon ImageAdd24}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <controls:SettingsCard Margin="0,4,0,4"
                                       Description="{Binding SelectedSource.Description}"
                                       Header="Shape from"
                                       HelpText="Which part of your picture appears around the QR code.&#x0a;&#x0a;• Whole picture: everything in the picture, turned into tiny black and white dots, like a photo printed in a newspaper. Best for photos.&#x0a;&#x0a;• Subject: only the main thing in the picture, such as a person or an animal on a plain background. The background stays white and the subject gets an outline.&#x0a;&#x0a;• QR code color: only the parts that have the same color as your QR code (black by default), for example the lines of a drawing. They are filled with a QR-style pattern, like the chicken on the Custom codes page."
                                       Icon="{ui:SymbolIcon ImageEdit24}"
                                       IsStacked="True">
                    <ComboBox DisplayMemberPath="Name"
                              ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="Lighter or darker before the picture is turned into dots. Raise it for dark photos."
                                       Header="Brightness"
                                       HelpText="Makes the picture lighter or darker before it is turned into dots.&#x0a;&#x0a;If the result looks too black, move the slider to the right. If it looks faded, move it to the left.&#x0a;&#x0a;This only changes the picture, never the QR code itself."
                                       Icon="{ui:SymbolIcon BrightnessHigh24}"
                                       IsEnabled="{Binding UsesTones}"
                                       IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="0.5"
                                Minimum="-0.5"
                                TickFrequency="0.05"
                                Value="{Binding Brightness}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{Binding Brightness, StringFormat={}{0:+0%;-0%;0%}}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Description="More contrast makes shapes stand out; less keeps soft shading."
                                       Header="Contrast"
                                       HelpText="How strongly the light and dark parts of the picture are separated.&#x0a;&#x0a;More contrast gives bold, clear shapes. Less keeps soft shading. If the picture looks gray and muddy, try more contrast."
                                       Icon="{ui:SymbolIcon DarkTheme24}"
                                       IsEnabled="{Binding UsesTones}"
                                       IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="2"
                                Minimum="0.5"
                                TickFrequency="0.1"
                                Value="{Binding Contrast}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{Binding Contrast, StringFormat={}{0:P0}}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Description="How much of the picture counts as the shape. Raise it if parts are missing, lower it if the background creeps in."
                                       Header="Sensitivity"
                                       HelpText="Decides how much of the picture counts as your subject or drawing.&#x0a;&#x0a;Raise it if parts of it are missing. Lower it if bits of the background show up.&#x0a;&#x0a;Only for the Subject and QR code color shapes: with Whole picture, all of the picture is used anyway."
                                       Icon="{ui:SymbolIcon Options24}"
                                       IsEnabled="{Binding UsesSensitivity}"
                                       IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="0.8"
                                Minimum="0.2"
                                TickFrequency="0.05"
                                Value="{Binding Sensitivity}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{Binding Sensitivity, StringFormat={}{0:P0}}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Description="The code's share of the picture. Smaller leaves more of the picture around it, with more detail."
                                       Header="Code size"
                                       HelpText="How big the QR code is compared to the picture.&#x0a;&#x0a;A smaller code leaves more room for the picture. But if you print the image small, a tiny code becomes hard for a phone to read, so keep it big enough to see its little squares clearly.&#x0a;&#x0a;You can also resize the blue square on the picture: drag its white corner or turn the mouse wheel."
                                       Icon="{ui:SymbolIcon QrCode24}"
                                       IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <!--  Fine steps: resizing on the template sets any size, and snapping would move it.  -->
                        <Slider VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="0.7"
                                Minimum="0.15"
                                TickFrequency="0.01"
                                Value="{Binding CodeSize}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{Binding CodeSize, StringFormat={}{0:P0}}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Margin="0,0,0,4"
                                       Description="{Binding SelectedDetail.Description}"
                                       Header="Detail"
                                       HelpText="How small the dots that make up the picture are.&#x0a;&#x0a;Smaller dots show more detail: Ultra looks most like the original picture. Normal gives a chunky, pixel-art look.&#x0a;&#x0a;The QR code itself works the same at every setting."
                                       Icon="{ui:SymbolIcon ZoomIn24}"
                                       IsStacked="True">
                    <ComboBox DisplayMemberPath="Name"
                              ItemsSource="{Binding Details}"
                              SelectedItem="{Binding SelectedDetail}" />
                </controls:SettingsCard>

                <controls:SettingsCard Margin="0,0,0,4"
                                       Description="{Binding SelectedCodeBlend.Description}"
                                       Header="Code blending"
                                       HelpText="Lets the picture show through the QR code, so it does not look like a sticker on top.&#x0a;&#x0a;A phone only reads the middle of each little square of a QR code, so the edges of each square can follow the picture.&#x0a;&#x0a;• Off: a plain black and white code.&#x0a;• Subtle: a little of the picture. The easiest to scan.&#x0a;• Balanced: a good mix.&#x0a;• Strong: the code almost disappears. Check that your phone can still scan it.&#x0a;&#x0a;The three big squares in the corners always stay solid: phones use them to find the code.&#x0a;&#x0a;Needs Extra fine or Ultra detail, and the Whole picture or Subject shape."
                                       Icon="{ui:SymbolIcon Blur24}"
                                       IsEnabled="{Binding CanBlendCode}"
                                       IsStacked="True">
                    <StackPanel>
                        <ComboBox DisplayMemberPath="Name"
                                  ItemsSource="{Binding CodeBlends}"
                                  SelectedItem="{Binding SelectedCodeBlend}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="Needs Extra fine or Ultra detail and the Whole picture or Subject shape. Every code is still checked to scan; if needed, the code is drawn more solid." />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>
        </controls:QrGeneratorView.TopContent>
    </controls:QrGeneratorView>
</Page>
