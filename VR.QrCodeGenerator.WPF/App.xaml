<Application x:Class="VR.QrCodeGenerator.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:converters="clr-namespace:VR.QrCodeGenerator.WPF.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Initial theme only; App.OnStartup applies the Windows theme and MainWindow follows its changes.  -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  The view models are platform-neutral: these turn their images and colors into WPF ones.  -->
            <converters:PreviewImageConverter x:Key="PreviewImageConverter" />
            <converters:DrawingColorConverter x:Key="DrawingColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>