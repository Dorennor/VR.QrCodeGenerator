<UserControl x:Class="VR.QrCodeGenerator.WPF.Controls.DrawingCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <!--  The paper is white in both themes: the drawing is black ink, like the code.  -->
        <Border x:Name="Paper"
                HorizontalAlignment="Center"
                Background="White"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid x:Name="Surface" ClipToBounds="True">
                <!--  Where the code goes. Under the ink, so lines drawn across it stay visible.  -->
                <Grid x:Name="CodeGuide" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Rectangle Fill="#140078D4"
                               Stroke="#990078D4"
                               StrokeDashArray="4 3"
                               StrokeThickness="1.5" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon HorizontalAlignment="Center"
                                       FontSize="28"
                                       Foreground="#990078D4"
                                       Symbol="QrCode24" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#CC0078D4"
                                   Text="QR code" />
                    </StackPanel>
                </Grid>

                <InkCanvas x:Name="Ink" Background="Transparent" Cursor="Pen" />
            </Grid>
        </Border>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Draw with the mouse or a pen."
                       TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button x:Name="UndoButton"
                           Click="Undo_OnClick"
                           Content="Undo"
                           Icon="{ui:SymbolIcon ArrowUndo24}"
                           ToolTip="Remove the last line" />
                <ui:Button x:Name="ClearButton"
                           Margin="8,0,0,0"
                           Click="Clear_OnClick"
                           Content="Clear"
                           Icon="{ui:SymbolIcon Delete24}"
                           ToolTip="Start a new drawing" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
