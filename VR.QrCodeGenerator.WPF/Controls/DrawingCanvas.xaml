<UserControl x:Class="VR.QrCodeGenerator.WPF.Controls.DrawingCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VR.QrCodeGenerator.WPF.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <StackPanel>
        <!--  Tools: what the mouse does on the sheet.  -->
        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
            <RadioButton x:Name="DrawMode"
                         Margin="0,0,16,0"
                         Checked="Mode_OnChecked"
                         Content="Draw"
                         GroupName="DrawingMode"
                         IsChecked="True">
                <RadioButton.ToolTip>
                    <ToolTip Style="{StaticResource HelpToolTipStyle}" Content="Draw with the mouse or a pen. Lines become solid black; shapes you close are filled with a QR-like pattern." />
                </RadioButton.ToolTip>
            </RadioButton>
            <RadioButton x:Name="EraseMode"
                         Margin="0,0,16,0"
                         Checked="Mode_OnChecked"
                         Content="Erase"
                         GroupName="DrawingMode">
                <RadioButton.ToolTip>
                    <ToolTip Style="{StaticResource HelpToolTipStyle}" Content="Click or drag over a line to remove the whole line." />
                </RadioButton.ToolTip>
            </RadioButton>
            <RadioButton x:Name="MoveMode"
                         Checked="Mode_OnChecked"
                         Content="Move code"
                         GroupName="DrawingMode">
                <RadioButton.ToolTip>
                    <ToolTip Style="{StaticResource HelpToolTipStyle}" Content="Move and resize the QR code (the blue square) instead of drawing.&#x0a;&#x0a;• Drag the square to move it.&#x0a;• Drag its white corner to make it bigger or smaller.&#x0a;• Click anywhere to put the code there.&#x0a;&#x0a;The mouse wheel over the sheet resizes the code in every mode." />
                </RadioButton.ToolTip>
            </RadioButton>
        </StackPanel>

        <!--  The paper is white in both themes: the drawing is black ink, like the code.  -->
        <Border HorizontalAlignment="Center"
                Background="White"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid x:Name="Surface"
                  ClipToBounds="True"
                  PreviewMouseWheel="Surface_OnPreviewMouseWheel">
                <InkCanvas x:Name="Ink" Background="Transparent" />

                <!--  Where the code goes. Only takes the mouse in "Move code" mode, so drawing goes through it otherwise.  -->
                <controls:CodePlacementOverlay x:Name="CodeOverlay"
                                               AreaHeight="{Binding CanvasPixels, ElementName=Root}"
                                               AreaWidth="{Binding CanvasPixels, ElementName=Root}"
                                               CodeCenter="{Binding CodeCenter, ElementName=Root, Mode=TwoWay}"
                                               CodeSize="{Binding CodeSize, ElementName=Root, Mode=TwoWay}"
                                               IsInteractive="False"
                                               MaxCodeSize="{Binding MaxCodeSize, ElementName=Root}"
                                               MinCodeSize="{Binding MinCodeSize, ElementName=Root}" />
            </Grid>
        </Border>

        <!--  Pen size.  -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Grid.ToolTip>
                <ToolTip Style="{StaticResource HelpToolTipStyle}" Content="How thick new lines are. Thicker lines show up better around a big QR code; lines you already drew stay as they are." />
            </Grid.ToolTip>
            <TextBlock Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyTextStyle}"
                       Text="Pen size" />
            <Slider x:Name="PenSizeSlider"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="24"
                    Minimum="4"
                    TickFrequency="2"
                    ValueChanged="PenSize_OnValueChanged"
                    Value="10" />
            <TextBlock Grid.Column="2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyTextStyle}"
                       Text="{Binding Value, ElementName=PenSizeSlider}" />
        </Grid>

        <StackPanel Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button Click="Undo_OnClick"
                       Content="Undo"
                       Icon="{ui:SymbolIcon ArrowUndo24}"
                       ToolTip="Remove the last line you drew." />
            <ui:Button Margin="8,0,0,0"
                       Click="Clear_OnClick"
                       Content="Clear"
                       Icon="{ui:SymbolIcon Delete24}"
                       ToolTip="Remove all lines and start a new drawing." />
            <ui:Button Margin="8,0,0,0"
                       Click="Center_OnClick"
                       Content="Center"
                       Icon="{ui:SymbolIcon AlignCenterHorizontal24}"
                       ToolTip="Put the QR code back in the middle of the sheet." />
        </StackPanel>
    </StackPanel>
</UserControl>
